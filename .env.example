PORT=8000
WEB_CONCURRENCY=2
# 前后端同域，无需设置 CORS；独立前端可填精确域名，多个用逗号分隔。
CORS_ORIGINS=
# 只有反向代理 IP 应加入信任列表。
FORWARDED_ALLOW_IPS=127.0.0.1
# 用于 compose.production.yml，请替换为已解析到服务器的真实域名。
APP_DOMAIN=assistant.example.com

# AI 教练：仅服务端读取。未配置时其他功能照常使用。
AI_API_KEY=
# 填服务商账户可用的模型 ID。
AI_MODEL=
# responses：Responses API；chat_completions：其他服务商的 Chat Completions 兼容接口。
AI_API_STYLE=responses
# 填服务商的基础地址，不要包含 /responses 或 /chat/completions。
AI_BASE_URL=https://api.openai.com/v1
# 可选英文数字访问口令；公网部署建议设置，用户在 AI 面板输入（不会持久保存）。
AI_ACCESS_TOKEN=
